# react-scripts@5.0.1 declares a peer of typescript ^3||^4, but this app uses
# typescript ^5. npm v7+ treats that peer conflict as a hard ERESOLVE error and
# `npm ci` fails. CRA works fine with TS5, so relax peer resolution to the pre-v7
# behaviour for this package (scoped to frontend/ only).
legacy-peer-deps=true
