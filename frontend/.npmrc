# react-scripts@5.0.1 declares a peer of typescript ^3||^4, but this app uses
# typescript ^5. npm v7+ treats that peer conflict as a hard ERESOLVE error and
# `npm ci` fails. CRA works fine with TS5, so relax peer resolution to the pre-v7
# behaviour for this package (scoped to frontend/ only).
legacy-peer-deps=true

# Private @izzywdev/* packages (e.g. @izzywdev/fuzefront-telemetry) live on GitHub Packages.
# Auth comes from the environment, never from this file. (npm does not support `${VAR:-}`
# defaults here: it sends the literal text as the token. Plain `${VAR}` is substituted.)
@izzywdev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
